<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>io.github.hexmaniac.mobile</ApplicationId>
    <ApplicationTitle>HexManiac Mobile</ApplicationTitle>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.2</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SolutionDir>$(MSBuildProjectDirectory)/../../</SolutionDir>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="../HexManiac.Core/Models/Code/*.txt;../HexManiac.Core/Models/Code/*.toml;../HexManiac.Core/Models/Code/*.md;../HexManiac.Core/Models/Code/*.py;../HexManiac.Core/Models/Code/*.hma">
      <Link>resources/%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HexManiac.Core/HexManiac.Core.csproj" />
  </ItemGroup>
</Project>
