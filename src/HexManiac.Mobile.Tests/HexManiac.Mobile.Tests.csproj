<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SolutionDir>$(MSBuildProjectDirectory)/../../</SolutionDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HexManiac.Core/HexManiac.Core.csproj" />
    <Compile Include="../HexManiac.Android/MobileTables.cs" Link="MobileTables.cs" />
    <Compile Include="../HexManiac.Android/HexEditorSession.cs" Link="HexEditorSession.cs" />
    <Content Include="../HexManiac.Core/Models/Code/*.txt;../HexManiac.Core/Models/Code/*.toml;../HexManiac.Core/Models/Code/*.md;../HexManiac.Core/Models/Code/*.py">
      <Link>resources/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
